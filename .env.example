# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techai
POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- LLM providers (at least one required) ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# --- Web search (optional) ---
TAVILY_SEARCH_API_KEY=your_tavily_api_key_here

# --- Qdrant vector store (optional) ---
QDRANT_URL=http://localhost:6333

# --- Ollama local models (optional) ---
OLLAMA_HOST=http://localhost:11434

# --- CORS ---
CORS_ORIGINS=http://localhost:8501
